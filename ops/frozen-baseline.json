      "original_text": "name: platform\non: [push, pull_request]\npermissions:\n  contents: read\njobs:\n  batch:\n    runs-on: ubuntu-latest\n    env: {SPARK_MASTER: 'local[2]', OMP_NUM_THREADS: '2', OPENBLAS_NUM_THREADS: '2'}\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-python@v5\n        with: {python-version: '3.12', cache: pip, cache-dependency-path: batch/requirements.txt}\n      - uses: actions/setup-java@v4\n        with: {distribution: temurin, java-version: '17'}\n      - run: pip install -r batch/requirements.txt\n      - run: python -m pytest --capture=sys -q tests\n        working-directory: batch\n  python:\n    runs-on: ubuntu-latest\n    env:\n      PYTHONPATH: .:text-risk\n      OMP_NUM_THREADS: '2'\n      OPENBLAS_NUM_THREADS: '2'\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-python@v5\n        with: {python-version: '3.12', cache: pip}\n      - run: pip install -r gateway/requirements-dev.txt flask==3.1.3\n      - run: python scripts/verify_artifacts.py\n      - run: python -m pytest --capture=sys -q gateway/tests text-risk/tests security/tests\n  console:\n    runs-on: ubuntu-latest\n    services:\n      postgres:\n        image: postgres:17-alpine\n        env: {POSTGRES_PASSWORD: postgres, PGUSER: postgres}\n        ports: ['15440:5432']\n        options: --health-cmd=pg_isready --health-interval=3s --health-retries=30\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-go@v5\n        with: {go-version: '1.26', cache-dependency-path: console/backend/go.sum}\n      - run: go test -race -count=1 ./...\n        working-directory: console/backend\n        env:\n          TEST_DATABASE_URL: postgres://postgres:postgres@127.0.0.1:15440/postgres?sslmode=disable\n      - uses: actions/setup-node@v4\n        with: {node-version: '24', cache: npm, cache-dependency-path: console/frontend/package-lock.json}\n      - run: npm ci && npm test && npm run build\n        working-directory: console/frontend\n  streaming:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-java@v4\n        with: {distribution: temurin, java-version: '17'}\n      - uses: sbt/setup-sbt@v1\n      - run: sbt -batch test\n        working-directory: streaming\n        env: {JAVA_TOOL_OPTIONS: '-XX:ActiveProcessorCount=2'}\n  graph:\n    runs-on: ubuntu-latest\n    env: {DEVICE: cpu, OMP_NUM_THREADS: '2', OPENBLAS_NUM_THREADS: '2', MKL_NUM_THREADS: '2'}\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-python@v5\n        with: {python-version: '3.12', cache: pip}\n      - run: pip install torch==2.15.0 --index-url https://download.pytorch.org/whl/cpu\n      - run: pip install -r research/graph/requirements-lock.txt\n      - run: python -m pytest --capture=sys -q tests\n        working-directory: research/graph\n  terraform:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n      - uses: hashicorp/setup-terraform@v3\n        with: {terraform_version: '1.14.0'}\n      - run: terraform fmt -check -recursive\n        working-directory: deploy/terraform\n      - run: terraform init -backend=false -input=false && terraform validate\n        working-directory: deploy/terraform\n  security:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-python@v5\n        with: {python-version: '3.12'}\n      - run: pip install bandit==1.9.4 semgrep==1.183.0\n      - run: python scripts/security_sast.py\n      - run: bash scripts/trivy.sh\n      - uses: actions/upload-artifact@v4\n        if: always()\n        with: {name: production-security, path: results/security}\n  integration:\n    runs-on: ubuntu-latest\n    timeout-minutes: 40\n    env:\n      COMPOSE_PROJECT_NAME: sentinel-ci\n      PYTHONPATH: .:text-risk\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-python@v5\n        with: {python-version: '3.12'}\n      - run: pip install -r gateway/requirements-dev.txt\n      - run: bash scripts/up.sh && bash scripts/demo.sh\n      - run: docker compose -f compose.yml exec -T console nginx -T > results/nginx-config.txt 2>&1\n      - run: python scripts/load_console.py\n      - run: python scripts/scan_console.py\n      - run: docker compose -f compose.yml logs --no-color > results/compose.log\n        if: always()\n      - uses: actions/upload-artifact@v4\n        if: always()\n        with: {name: compose-integration, path: results}\n      - run: docker compose -f compose.yml down -v\n        if: always()\n"

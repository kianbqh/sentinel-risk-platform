"""Small, explicit synthetic fixtures only. Never reads real run predictions."""
from __future__ import annotations

from copy import deepcopy
from dataclasses import replace
import json
from pathlib import Path
import statistics
import sys
import tempfile
import unittest
from unittest.mock import patch

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT))
import posthoc_format_diagnostic as diagnostic


def write_json(path, value):
    with path.open("w", encoding="utf-8", newline="\n") as stream:
        json.dump(value, stream, indent=2, allow_nan=False)
        stream.write("\n")


def write_jsonl(path, rows):
    with path.open("w", encoding="utf-8", newline="\n") as stream:
        for row in rows:
            stream.write(json.dumps(row, separators=(",", ":"), allow_nan=False) + "\n")


def reference(path):
    return {"path": str(path), "sha256": diagnostic.sha256(path)}


def fixture(root, real_context):
    """Four invented IDs, two paired IDs and 12 timed rows per fake system."""
    ids, labels = ["SYNTHETIC-0", "SYNTHETIC-1", "SYNTHETIC-2", "SYNTHETIC-3"], [1, 0, 1, 0]
    context = replace(real_context, identifiers={"full1035_ids": ids, "full1035_labels": labels,
                      "paired400_ids": [ids[2], ids[0]], "paired400_labels": [1, 1]}, synthetic=True)
    diagnostic.validate_identifiers(context.identifiers, 4, 2)
    group = "/opt/codex-resume/all-modules-v2/m1a/runs/continuation-SYNTHETIC-ONLY"
    proof = {"git_sha": context.git_sha, "config_sha256": context.config_sha256,
             "protocol_sha256": context.split_sha256, "selected_source_dirty": False,
             "versions": {"fixture": "stdlib-only"},
             "source_files": [{"path": "text-risk/finetune/modeling.py", "sha256": context.parser_sha256}]}
    raw_by_system = [
        ['```json\n{"label":"scam"}\n```', '{"label":"legit"}',
         '```\n{"label":"scam","extra":1}\n```', '```json\n{"label":"scam","label":"legit"}\n```'],
        ['```json\n{"label":"scam"}\n```', '{"label":"legit"}', '{"label":"scam"}', '{"label":"legit"}'],
        ['{"label":"scam"}', '```\n{"label":"legit"}\n```', '{"label":"legit"}', '{"label":"legit"}'],
        ['```json\n{"label":"SCAM"}\n```', '{"label":"legit"}',
         '```json\n{"label":"scam"}\n```', '```\n{"label":"legit"}\n```'],
    ]
    spec = {"schema_version": 1, "kind": "synthetic_fixture", "systems": {}}
    summaries, predictions, completion_items = {}, {}, []
    for system, run_name, seed, raws in zip(diagnostic.SYSTEMS, diagnostic.RUN_NAMES, diagnostic.SEEDS, raw_by_system):
        folder = root / run_name
        folder.mkdir()
        rows = []
        for index, (item, label, raw) in enumerate(zip(ids, labels, raws)):
            parsed, failure = context.parser(raw)
            # Invented deterministic fallback values, never actual message classification.
            prediction = (1 if index in (1, 3) else 0) if failure else parsed
            rows.append({"id": item, "y": label, "repeat": 0, "prediction": prediction,
                         "raw": raw, "failure": failure, "fallback_used": failure is not None,
                         "latency_ms": 1.25 + index / 10, "input_tokens": 8, "output_tokens": 6,
                         "truncated": False})
        timed = [{**row, "repeat": repeat} for repeat in range(3) for row in rows]
        write_jsonl(folder / "predictions.jsonl", rows)
        write_jsonl(folder / "latency.jsonl", timed)
        by_id = {row["id"]: row for row in rows}
        sets = {name: diagnostic.primary_metrics([by_id[item] for item in context.identifiers[name + "_ids"]])
                for name in ("full1035", "paired400")}
        counts = {}
        for row in timed:
            if row["failure"]:
                counts[row["failure"]] = counts.get(row["failure"], 0) + 1
        summary = {"status": "evaluated", "kind": "evaluation", "provenance": deepcopy(proof),
                   "system": "prompt_only_nf4+rules_on_invalid_json" if seed is None else "qlora_nf4+rules_on_invalid_json",
                   "training_seed": seed, "first_repeat_quality_only": True,
                   "benchmark": {"repeats": 3, "concurrency": 1, "batch_size": 1, "quality_repeat": 0,
                                 "warmup_messages": 3, "n_samples": 12}, "sets": sets,
                   "failure_counts_all_timed_calls": counts, "repeat_disagreements": [],
                   "prediction_sha256": diagnostic.sha256(folder / "predictions.jsonl"),
                   "latency_sha256": diagnostic.sha256(folder / "latency.jsonl")}
        write_json(folder / "summary.json", summary)
        spec["systems"][system] = {"run_path": group + "/" + run_name,
                                   **{key: reference(folder / filename) for key, filename in
                                      (("summary", "summary.json"), ("predictions", "predictions.jsonl"), ("latency", "latency.jsonl"))}}
        summaries[system], predictions[system] = summary, rows
        for path in folder.iterdir():
            completion_items.append({"path": run_name + "/" + path.name, "bytes": path.stat().st_size,
                                     "sha256": diagnostic.sha256(path)})
    comparison_folder = root / "comparison"
    comparison_folder.mkdir()
    comparison_rows = [{"id": item, "y": labels[index],
                        "systems": {name: predictions[name][index]["prediction"] for name in diagnostic.SYSTEMS}}
                       for index, item in enumerate(ids)]
    write_jsonl(comparison_folder / "comparison-predictions.jsonl", comparison_rows)
    comparison = {"status": "compared", "kind": "comparison", "provenance": deepcopy(proof),
                  "predictions_sha256": diagnostic.sha256(comparison_folder / "comparison-predictions.jsonl"),
                  "model_evaluations": [{"path": group + "/" + run_name, "training_seed": seed,
                                         "summary_sha256": spec["systems"][name]["summary"]["sha256"],
                                         "sets": summaries[name]["sets"], "benchmark": summaries[name]["benchmark"]}
                                        for name, run_name, seed in zip(diagnostic.SYSTEMS, diagnostic.RUN_NAMES, diagnostic.SEEDS)],
                  "sets": {set_name: {"scores": {name: {key: summaries[name]["sets"][set_name][key]
                                                        for key in diagnostic.METRIC_KEYS}
                                                for name in diagnostic.SYSTEMS}}
                           for set_name in ("full1035", "paired400")}}
    write_json(comparison_folder / "summary.json", comparison)
    spec["comparison"] = {"run_path": group + "/comparison", "summary": reference(comparison_folder / "summary.json"),
                          "predictions": reference(comparison_folder / "comparison-predictions.jsonl")}
    for path in comparison_folder.iterdir():
        completion_items.append({"path": "comparison/" + path.name, "bytes": path.stat().st_size,
                                 "sha256": diagnostic.sha256(path)})
    completion = {"status": "completed", "expected_git_sha": context.git_sha, "files": completion_items}
    write_json(root / "CONTINUATION_COMPLETE.json", completion)
    spec["continuation_complete"] = reference(root / "CONTINUATION_COMPLETE.json")
    write_json(root / "inputs.json", spec)
    return context, spec, summaries


class FenceAndParserTests(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        cls.context = diagnostic.load_context()

    def test_exact_single_outer_fence(self):
        for raw, expected in [(' \n```json\n{"label":"scam"}\n```\t ', 1),
                              ('```\n{"label":"legit"}\n```', 0),
                              ('```json\r\n{"label":"scam"}\r\n```', 1),
                              ('```json\r{"label":"scam"}\r```', 1)]:
            normalized, removed = diagnostic.remove_one_outer_fence(raw)
            self.assertTrue(removed)
            self.assertEqual(self.context.parser(normalized), (expected, None))
        self.assertEqual(diagnostic.remove_one_outer_fence('```json\n```'), ("", True))
        self.assertEqual(diagnostic.remove_one_outer_fence(' \n{"label":"legit"}\t '), ('{"label":"legit"}', False))

    def test_refuses_prose_partial_wrong_delimiters_and_recursive_repair(self):
        for raw in ['before\n```json\n{"label":"scam"}\n```', '```json\n{"label":"scam"}\n```\nafter',
                    '```JSON\n{"label":"scam"}\n```', '``` json\n{"label":"scam"}\n```',
                    '```json\n{"label":"scam"}', '```json\n{"label":"scam"}\n ````',
                    '```json {"label":"scam"}```']:
            normalized, removed = diagnostic.remove_one_outer_fence(raw)
            self.assertFalse(removed)
            self.assertIsNotNone(self.context.parser(normalized)[1])
        normalized, removed = diagnostic.remove_one_outer_fence('```json\n```json\n{"label":"scam"}\n```\n```')
        self.assertTrue(removed)
        self.assertIsNotNone(self.context.parser(normalized)[1])

    def test_unchanged_strict_schema_and_duplicate_key_contract(self):
        for raw, failure in [('{"label":"scam","label":"legit"}', "invalid_json"),
                             ('{"label":"Scam"}', "schema"), ('{"label":true}', "schema"),
                             ('{"label":1}', "schema"), ('{"label":"scam","extra":0}', "schema"),
                             ('["scam"]', "schema"), ('null', "schema")]:
            self.assertEqual(self.context.parser(raw), (None, failure))
            fenced, removed = diagnostic.remove_one_outer_fence("```json\n" + raw + "\n```")
            self.assertTrue(removed)
            self.assertEqual(self.context.parser(fenced), (None, failure))

    def test_preserves_json_body_unicode_line_separator(self):
        body = '{"label":"scam","extra":"left\u2028right"}'
        self.assertEqual(diagnostic.remove_one_outer_fence("```json\n" + body + "\n```"), (body, True))


class SyntheticBundleTests(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        cls.real_context = diagnostic.load_context()

    def setUp(self):
        self.temp = tempfile.TemporaryDirectory(prefix="SYNTHETIC-ONLY-", dir=ROOT)
        self.root = Path(self.temp.name)
        self.context, self.spec, self.summaries = fixture(self.root, self.real_context)

    def tearDown(self):
        self.temp.cleanup()

    def validate(self, spec=None):
        return diagnostic.validate_bundle(spec or self.spec, self.root, self.context)

    def update_artifact(self, location, path, value, completion_relative=None):
        write_json(path, value)
        location.update(reference(path))
        if completion_relative:
            completion_path = self.root / "CONTINUATION_COMPLETE.json"
            completion = diagnostic.read_json(completion_path)
            for item in completion["files"]:
                if item["path"] == completion_relative:
                    item.update(bytes=path.stat().st_size, sha256=diagnostic.sha256(path))
            write_json(completion_path, completion)
            self.spec["continuation_complete"] = reference(completion_path)

    def test_descriptive_report_uniform_rule_fallback_and_input_preservation(self):
        before = {path: diagnostic.sha256(path) for path in self.root.rglob("*") if path.is_file()}
        output = self.root / "diagnostic-output"
        report = diagnostic.run_diagnostic(self.root / "inputs.json", output, self.context)
        self.assertTrue(report["synthetic"])
        self.assertEqual(report["status"], "synthetic_test_only")
        self.assertTrue(all(diagnostic.sha256(path) == digest for path, digest in before.items()))
        prompt = report["systems"]["prompt_only_nf4"]["sets"]["full1035"]
        self.assertEqual(prompt["strict_primary"], self.summaries["prompt_only_nf4"]["sets"]["full1035"])
        normalized = prompt["posthoc_format_diagnostic"]
        self.assertEqual((normalized["tp"], normalized["tn"], normalized["fp"], normalized["fn"]), (1, 1, 1, 1))
        self.assertEqual((normalized["valid_count"], normalized["retained_fallback_count"], normalized["newly_valid_count"]), (2, 2, 1))
        self.assertEqual(normalized["f1"], 0.5)
        self.assertEqual(normalized["valid_only_metrics"]["f1"], 1.0)
        for name in diagnostic.SYSTEMS:
            self.assertEqual(report["systems"][name]["sets"]["paired400"]["posthoc_format_diagnostic"]["n"], 2)
        variation = report["qlora_training_seed_variation"]["full1035"]["posthoc_format_diagnostic"]
        values = [1.0, 2 / 3, 2 / 3]
        self.assertEqual(variation["metrics"]["f1"], {"raw": values, "mean": statistics.mean(values), "std": statistics.pstdev(values)})
        output_rows = diagnostic.read_jsonl(output / "diagnostic-predictions.jsonl", 16)
        self.assertEqual(output_rows[2]["prediction"], output_rows[2]["original"]["prediction"])
        self.assertEqual(output_rows[3]["prediction"], output_rows[3]["original"]["prediction"])
        self.assertFalse(diagnostic.HEAVY_MODULES.intersection(sys.modules))
        manifest = diagnostic.read_json(output / "output-manifest.json")
        self.assertTrue(all(diagnostic.sha256(output / item["path"]) == item["sha256"] for item in manifest["files"]))

    def test_all_complete_status_gates_precede_prediction_reads(self):
        for kind, expected in (("completion", "not completed"), ("comparison", "comparison is incomplete"),
                               ("evaluation", "evaluation is incomplete")):
            with self.subTest(kind=kind):
                spec = deepcopy(self.spec)
                if kind == "completion":
                    path = self.root / "incomplete-continuation.json"
                    value = diagnostic.read_json(self.root / "CONTINUATION_COMPLETE.json")
                    value["status"] = "running"
                    write_json(path, value)
                    spec["continuation_complete"] = reference(path)
                else:
                    key = spec["comparison"] if kind == "comparison" else spec["systems"]["qlora_seed_44"]
                    value = diagnostic.read_json(Path(key["summary"]["path"]))
                    value["status"] = "running"
                    path = self.root / (kind + "-incomplete.json")
                    write_json(path, value)
                    key["summary"] = reference(path)
                with patch.object(diagnostic, "read_jsonl", side_effect=AssertionError("prediction read before gate")):
                    with self.assertRaisesRegex(ValueError, expected):
                        self.validate(spec)

    def test_refuses_artifact_hash_tamper(self):
        path = Path(self.spec["systems"]["qlora_seed_44"]["predictions"]["path"])
        with path.open("a", encoding="utf-8") as stream:
            stream.write(" ")
        with self.assertRaisesRegex(ValueError, "SHA256 mismatch"):
            self.validate()

    def test_refuses_comparison_summary_reference_tamper(self):
        key = self.spec["comparison"]
        path = Path(key["summary"]["path"])
        value = diagnostic.read_json(path)
        value["model_evaluations"][3]["summary_sha256"] = "0" * 64
        self.update_artifact(key["summary"], path, value, "comparison/summary.json")
        with self.assertRaisesRegex(ValueError, "comparison summary SHA reference differs"):
            self.validate()

    def test_refuses_provenance_and_run_mixing(self):
        for changed, expected in (("run_path", "mixed evaluation"), ("parser", "strict parser differs"),
                                  ("config", "configuration SHA mismatch"), ("split", "protocol SHA mismatch")):
            with self.subTest(changed=changed):
                spec = deepcopy(self.spec)
                entry = spec["systems"]["qlora_seed_44"]
                if changed == "run_path":
                    entry["run_path"] = entry["run_path"].replace("continuation-SYNTHETIC-ONLY", "continuation-OTHER")
                else:
                    value = diagnostic.read_json(Path(entry["summary"]["path"]))
                    if changed == "parser":
                        value["provenance"]["source_files"][0]["sha256"] = "0" * 64
                    else:
                        value["provenance"]["config_sha256" if changed == "config" else "protocol_sha256"] = "0" * 64
                    path = self.root / (changed + "-wrong.json")
                    write_json(path, value)
                    entry["summary"] = reference(path)
                with self.assertRaisesRegex(ValueError, expected):
                    self.validate(spec)

    def test_refuses_order_label_repeat_fallback_and_primary_changes(self):
        records, summaries, _, _ = self.validate()
        first = records["prompt_only_nf4"]
        timed_path = Path(self.spec["systems"]["prompt_only_nf4"]["latency"]["path"])
        timed = diagnostic.read_jsonl(timed_path, 12)
        mutations = [lambda rows: rows[4].update(id="WRONG"), lambda rows: rows[5].update(y=1),
                     lambda rows: rows[6].update(repeat=0), lambda rows: rows[7].update(fallback_used=False),
                     lambda rows: rows[5].update(prediction=1)]
        for mutate in mutations:
            changed = deepcopy(timed)
            mutate(changed)
            with self.assertRaises(ValueError):
                diagnostic.validate_timed_rows(first, changed, summaries["prompt_only_nf4"], self.context)
        changed = deepcopy(summaries["prompt_only_nf4"])
        changed["sets"]["full1035"]["f1"] = 0.12345
        with self.assertRaisesRegex(ValueError, "summary metrics differ"):
            diagnostic.validate_timed_rows(first, timed, changed, self.context)

    def test_frozen_pair_order_labels_and_unique_ids(self):
        for change in (lambda ids: ids["paired400_ids"].append("OUTSIDE"),
                       lambda ids: ids["paired400_labels"].__setitem__(0, 0),
                       lambda ids: ids["full1035_ids"].__setitem__(1, ids["full1035_ids"][0])):
            identifiers = deepcopy(self.context.identifiers)
            change(identifiers)
            with self.assertRaises(ValueError):
                diagnostic.validate_identifiers(identifiers, 4, 2)

    def test_zero_valid_rows_are_null_and_fallback_retained(self):
        rows = [{"id": "SYNTHETIC-INVALID", "y": 1, "prediction": 1, "raw": "no JSON", "failure": "invalid_json"}]
        diagnosed = diagnostic.diagnose_records(rows, self.context)
        result = diagnostic.diagnostic_metrics(diagnosed)
        self.assertIsNone(result["valid_only_metrics"])
        self.assertEqual(result["retained_fallback_count"], 1)
        self.assertEqual(result["f1"], 1)

    def test_create_only_and_no_output_after_invalid_inputs(self):
        output = self.root / "exists"
        output.mkdir()
        with self.assertRaisesRegex(ValueError, "create-only"):
            diagnostic.run_diagnostic(self.root / "inputs.json", output, self.context)
        spec = deepcopy(self.spec)
        spec["kind"] = "closed_m1a_posthoc_inputs"
        path = self.root / "invalid-inputs.json"
        write_json(path, spec)
        out = self.root / "must-not-exist"
        with self.assertRaisesRegex(ValueError, "scope mismatch"):
            diagnostic.run_diagnostic(path, out, self.context)
        self.assertFalse(out.exists())
        with self.assertRaisesRegex(ValueError, "scope mismatch"):
            diagnostic.validate_bundle(self.spec, self.root, self.real_context)


if __name__ == "__main__":
    unittest.main(verbosity=2)
